# ==============================================================================
# Autonomous LinkedIn Gen AI Agent - Environment Configuration
# ==============================================================================

# 1. Telegram Bot (REQUIRED for approvals & notifications on your phone)
# Create a bot in 30 seconds via @BotFather on Telegram to get your token.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Your personal Telegram Chat ID (message @userinfobot to find your ID)
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 2. LLM Provider Configuration
# Choose your preferred provider: "groq" | "gemini" | "openai" | "anthropic"
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# 3. Database Configuration
# "sqlite" for self-contained cloud deployment or "mysql" for external database
DB_TYPE=sqlite

# 4. LinkedIn Publishing API (Publora)
PUBLORA_API_KEY=your_publora_api_key_here
LINKEDIN_PLATFORM_ID=your_linkedin_platform_id_here

# 5. Scheduling & Timezone Settings
# Time of day to run the autonomous morning research & post draft (24h format, HH:MM)
SCHEDULE_TIME=07:30
TIMEZONE=Asia/Kolkata

# Max daily high-authority connection recommendations sent to Telegram
MAX_DAILY_CONNECTIONS=3
